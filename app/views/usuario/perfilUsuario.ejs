<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Editar pefil</title>
    <link href="styles.css" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
  </head>
  <body class="sb-nav-fixed">
    <!--Cabecera -->
    <%- include('../_partials/headerUsuario') %>
    <div id="layoutSidenav">
      <%- include('../_partials/sidebarUsuario') %>
      <!--Area de contenido-->
      <div id="layoutSidenav_content">
        <main>
          <div class="container-fluid">
            <h1 class="mt-4">Editar perfil</h1>
            <ol class="breadcrumb mb-4">
              <li class="breadcrumb-item active">Datos personales</li>
            </ol>
            <form class="row g-3">
              <div class="col-md-4">
                <label class="form-label">Nombres:</label>
                <div class="input-group">
                  <span class="input-group-text"
                    ><i class="fa-solid fa-user"></i
                  ></span>
                  <input
                    class="form-control"
                    type="text"
                    name="nombre"
                    id="nombres"
                  />
                </div>
              </div>
              <div class="col-md-4">
                <label class="form-label">Apellidos:</label>
                <div class="input-group">
                  <span class="input-group-text"
                    ><i class="fa-solid fa-user"></i
                  ></span>
                  <input
                    class="form-control"
                    type="text"
                    name="apellidos"
                    id="apellidos"
                  />
                </div>
              </div>
              <div class="col-md-4">
                <label class="form-label">Tipo de documento:</label>
                <div class="input-group">
                  <span class="input-group-text"
                    ><i class="fa-solid fa-address-card"></i
                  ></span>
                  <select
                    class="form-select"
                    aria-label="Default select example"
                  >
                    <option value="1">CC</option>
                  </select>
                </div>
              </div>
              <div class="col-4">
                <label class="form-label">Numero de documento</label>
                <div class="input-group">
                  <span class="input-group-text"
                    ><i class="fa-solid fa-user"></i
                  ></span>
                  <input
                    class="form-control"
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    maxlength="20"
                    name="cedula"
                    id="cedula"
                    required
                  />
                </div>
              </div>
              <div class="col-4">
                <label class="form-label">Fecha de nacimiento</label>
                <div class="input-group">
                  <span class="input-group-text"
                    ><i class="fa-solid fa fa-calendar"></i
                  ></span>
                  <input
                    class="form-control"
                    type="date"
                    name="fechaNacimiento"
                    id="fechaNacimiento"
                    required
                  />
                </div>
              </div>
              <div class="col-4">
                <label class="form-label">Telefono</label>
                <div class="input-group">
                  <span class="input-group-text"
                    ><i class="fa-solid fa fa-phone"></i
                  ></span>
                  <input
                    class="form-control"
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    maxlength="15"
                    name="telefono"
                    id="telefono"
                    required
                  />
                </div>
              </div>
              <div class="col-4">
                <label class="form-label">Barrio</label>
                <div class="input-group">
                  <span class="input-group-text"
                    ><i class="fa solid fa-address-book"></i
                  ></span>
                  <input
                    class="form-control"
                    type="text"
                    maxlength="50"
                    name="barrio"
                    id="barrio"
                    required
                  />
                </div>
              </div>
              <div class="col-4">
                <label class="form-label">Direccion</label>
                <div class="input-group">
                  <span class="input-group-text"
                    ><i class="fa solid fa-address-book"></i
                  ></span>
                  <input
                    class="form-control"
                    type="text"
                    maxlength="40"
                    name="nomenclatura"
                    id="nomenclatura"
                    required
                  />
                </div>
              </div>
              <div class="col-4">
                <label class="form-label">Subir foto</label>
                <div class="input-group">
                  <span class="input-group-text"
                    ><i class="fa solid fa-file-image"></i
                  ></span>
                  <input
                    class="form-control"
                    type="file"
                    name="foto"
                    id="foto"
                    accept=".jpg, .jpeg, .png"
                    required
                  />
                </div>
                </div>
              </div>
                <div class="text-center mt-4">
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
</div>
            </form>
            </div>
          </div>
        </main>
        <footer class="py-4 bg-light mt-auto">
          <div class="container-fluid">
            <div
              class="d-flex align-items-center justify-content-between small"
            >
              <div class="text-muted">Copyright &copy; Your Website 2026</div>
              <div>
                <a href="#">Privacy Policy</a>
                &middot;
                <a href="#">Terms &amp; Conditions</a>
              </div>
            </div>
          </div>
        </footer>
      </div>
    </div>
    <!-- JQuery-->
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/jquery/4.0.0/jquery.min.js"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
      crossorigin="anonymous"
    ></script>
    <!-- Tata Table-->
    <script
      src="https://cdn.datatables.net/3.1.5/js/dataTables.min.js"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.datatables.net/1.10.20/js/dataTables.bootstrap5.min.js"
      crossorigin="anonymous"
    ></script>
    <script src="assets/demo/datatables-demo.js"></script>
    <script src="scripts.js"></script>
  </body>
</html>
